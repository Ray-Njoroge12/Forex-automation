# Copy to fx_ai_engine/.env (gitignored). Existing environment variables win over this file.

# macOS: read market data and account state from the EA file bridge (ADR 0001, D4).
MT5_CONNECTION=file_bridge
BRIDGE_BASE_PATH=/Users/<you>/Library/Application Support/net.metaquotes.wine.metatrader5/drive_c/Program Files/MetaTrader 5/MQL5/Files/bridge

# Optional alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
